# Dependencies
node_modules/
# This project is pnpm. pnpm-lock.yaml is the tracked lockfile and CI installs
# with --frozen-lockfile, so an npm lockfile is not a second opinion — it is
# the residue of running the wrong package manager, and committing one lets
# package.json and pnpm-lock.yaml drift apart until CI catches it.
package-lock.json

# Build output
dist/
*.tsbuildinfo

# Environment files — never commit real keys
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.local

# Vercel
.vercel/

# Build stamp for git-less uploads (see vite.config.ts)
.build-sha
