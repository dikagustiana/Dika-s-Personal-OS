{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-os.dikagustiana.com/schemas/lab-hermes/result-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "budget_exceeded"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "fact",
                  "inference",
                  "assumption"
                ]
              },
              "corpus_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "corpus_refs"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "markdown",
        "claims",
        "limitations"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "corpus_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "retrieval",
              "dataset",
              "methodology",
              "execution",
              "assumption",
              "output",
              "submission"
            ]
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "fetched_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_content_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "string"
          }
        },
        "required": [
          "corpus_id",
          "kind",
          "source",
          "url",
          "fetched_at",
          "content_hash",
          "raw_content_hash",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "call_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "cancelled"
            ]
          },
          "corpus_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "event_id",
          "call_id",
          "name",
          "started_at",
          "finished_at",
          "status",
          "corpus_ids"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unresolved_reserved_usd": {
          "type": "number",
          "minimum": 0
        },
        "cost_status": {
          "enum": [
            "calculated",
            "partial",
            "reconciled"
          ]
        },
        "price_route_id": {
          "type": "string"
        },
        "native_currency": {
          "enum": [
            "USD",
            "CNY"
          ]
        },
        "native_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fx_usd_per_native": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "known_cost_usd",
        "unresolved_reserved_usd",
        "cost_status",
        "price_route_id",
        "native_currency",
        "native_cost",
        "fx_usd_per_native"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "hermes_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "adapter_version": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "hermes_commit",
        "adapter_version",
        "session_id",
        "provider",
        "model",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "skill_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_agent_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "proposed_prompt": {
            "type": "string",
            "minLength": 1
          },
          "reference_files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "content": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "content",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target_agent_id",
          "base_version_id",
          "rationale",
          "proposed_prompt",
          "reference_files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "attempt",
    "status",
    "output",
    "provenance",
    "tool_calls",
    "usage",
    "runtime",
    "error",
    "skill_proposals"
  ],
  "additionalProperties": false
}
