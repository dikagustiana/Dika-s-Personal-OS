{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-os.dikagustiana.com/schemas/lab-hermes/agent-config-v1.json",
  "type": "object",
  "properties": {
    "executor": {
      "const": "hermes"
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "kimi",
        "deepseek",
        "anthropic",
        "nous"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_region": {
      "enum": [
        "global",
        "china",
        "direct",
        "nous"
      ]
    },
    "api_mode": {
      "enum": [
        "chat_completions",
        "anthropic_messages"
      ]
    },
    "auxiliary": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "tool_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "fallback_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "max_cost_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "provenance_required": {
      "type": "boolean"
    }
  },
  "required": [
    "executor",
    "route_id",
    "provider",
    "model",
    "endpoint_region",
    "api_mode",
    "auxiliary",
    "tool_allowlist",
    "fallback_routes",
    "max_turns",
    "max_output_tokens",
    "timeout_seconds",
    "max_cost_usd",
    "provenance_required"
  ],
  "additionalProperties": false
}
