{
  "name": "bot-crossing",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time 3D visualisation of autonomous AI agent execution as activity inside a stylised desert office campus.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "probe": "tsx scripts/probe-stream.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/websocket": "11.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "@tanstack/react-query": "5.102.8",
    "fastify": "5.12.3",
    "honeycomb-grid": "4.1.5",
    "n8ao": "1.10.3",
    "next": "14.2.35",
    "postprocessing": "6.39.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "ws": "8.21.3",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.170.0",
    "@types/ws": "8.18.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
