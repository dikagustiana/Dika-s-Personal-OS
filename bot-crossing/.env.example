# WebSocket endpoint the browser connects to for the canonical event stream.
NEXT_PUBLIC_EVENT_WS_URL=ws://localhost:4000/events
# REST base for telemetry (TanStack Query): logs, history, output documents.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Show the developer panel (time scrubber, grid mode, perf) without ?dev=1.
NEXT_PUBLIC_DEV_TOOLS=1
# Server: which event source feeds the stream. mock | live
EVENT_SOURCE=mock
PORT=4000
