# Supabase backend. Leave both unset to run against the in-memory mock
# repository (no persistence, seeded data — works with a bare clone).
# Both values are public by nature: they ship in the client bundle. The
# database itself is guarded by the app passphrase via RLS, not by these.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
